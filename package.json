{
  "name": "Rate My PrUFessors",
  "version": "3.25",
  "description": "Links and displays RMP/GatorEvals data while searching for classes on ONE.UF",
  "private": true,
  "type": "module",
  "dependencies": {
    "arrive": "^2.4.1",
    "papaparse": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tippy.js": "^6.3.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.5",
    "@types/chrome": "^0.1.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/webextension-polyfill": "^0.12.3",
    "copy-webpack-plugin": "^11.0.0",
    "jest": "^29.5.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "web-ext": "^7.6.2",
    "web-ext-plugin": "^2.8.1",
    "webextension-polyfill": "^0.10.0",
    "webpack": "^5.87.0",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "tsc": "tsc",
    "clean": "rm -rf build/*; rm -rf dist/*",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "build:chrome": "tsc && webpack --env browser=chrome --env production --config webpack.config.mjs",
    "build:firefox": "tsc && webpack --env browser=firefox --env production --config webpack.config.mjs",
    "build-dev:chrome": "tsc && webpack --env browser=chrome --env development --mode development --config webpack.config.mjs",
    "build-dev:firefox": "tsc && webpack --env browser=firefox --env development --mode development --config webpack.config.mjs",
    "release": "npm run clean && npm run build:chrome && npm run build:firefox"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jereme-yang/Rate-My-PrUFessors.git"
  },
  "bugs": {
    "url": "https://github.com/jereme-yang/Rate-My-PrUFessors/issues"
  },
  "homepage": "https://github.com/jereme-yang/Rate-My-PrUFessors#readme"
}
